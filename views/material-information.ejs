            processCalc(ppd7, tpd7);
            processCalc(m2s, m2ts);
            processCalc(pps7, tps7);
            processCalc(ppf7, tpf7);
            processCalc(ppfs7, tpfs7);
            processCalc(pff7, tpff7);
            //total
            processCalc(ttd, tttd);
            processCalc(ppd, tpd);
            processCalc(tts, ttts);
            processCalc(pps, tps);
            processCalc(ppf, tpf);
            processCalc(ppfs, tpfs);
            processCalc(pff, tpff);

        },500)
});

