<%- include('partials/header') %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
 

<style>
    /* ตารางนี้มี 13 คอลัมน์ ต้องกว้างพอสมควรจึงจะอ่านได้ ให้ยืดเต็มพื้นที่
       ที่มีจริง แล้วเลื่อนแนวนอนเฉพาะตอนจอแคบกว่านั้น */
    .content-mat { width: 100%; }
    .content-mat .table-responsive { overflow-x: auto; }
    .content-mat table { min-width: 1180px; font-size: .72rem !important; }
    .content-mat .section-1 { width: 100%; }
    .content-mat thead th { background: var(--wb-green); color: #fff; }

    @media print {
        body .no-print {
            display: none !important;
        }
        .scroll-content {
            overflow-x: hidden;
        }
        .section-2 {
            page-break-after: always;
        }
        .section-3 {
            page-break-after: always;
        }
        .section-4 {
            page-break-after: always;
        }
        .section-5 {
            page-break-after: always;
        }
    }
</style>
    <div  class="scroll-content">
        <% if (typeof hiddenCategories !== 'undefined' && hiddenCategories.length) { %>
            <div class="alert alert-warning mx-4 mt-3 no-print">
                <strong>มีหมวดสินค้าที่ไม่ได้แสดงในตารางนี้</strong>
                — หน้านี้รองรับเฉพาะ 7 หมวดหลัก สินค้าในหมวดต่อไปนี้จึงไม่ถูกนับในยอดรวม:
                <%= hiddenCategories.map(c => `${c.category} (${c.items} รายการ)`).join(' · ') %>
            </div>
        <% } %>
        <div class="row py-5 px-4 logo">
            <div class="col-lg-3 col-xxl-2 col-sm-12">
                <img src="/images/logo3.png" height="150" alt="">
            </div>
            <div class="col-lg-9 col-xxl-10 col-sm-12">
                <h2 class="fs-1 fw-bold text-success">Wastebuy Delivery  Co., Ltd.</h2>
                <div class="mt-2 lead ">
                    <p class="fs-4">Material Information</p>
                    <p class="fs-5"> ตั้งแต่วันที่  <%= startDate  %> ถึงวันที่ <%= endDate %></p>
                    <form id="searchForm" action="/material-information" method="get">
                        <div class="d-flex no-print align-items-center">
                            <div class="mx-2 d-flex flex-column">
                                <label for="startDate">Start date</label>
                                <input class="form-control" type="date" id="startDate" name="startDate" value="<%= isoValue(startDate) %>" required>
                            </div>
                            <div class="mx-2 d-flex flex-column">
                                <label for="endDate">End date</label>
                                <input class="form-control" type="date" id="endDate" name="endDate" value="<%= isoValue(endDate) %>" required>
                            </div>
                            <div class="d-flex p-2 mx-3 mt-2 justify-content-between" style="position: relative; top: 10px;">
                                    <button type="button" class="btn btn-warning mx-1 px-4 my-4 text-white shadow-sm rounded-5" style="height: 30px; font-size: 12px;" id="export-excel">Excel</button>
                                    <!-- <button type="button" class="btn btn-primary mx-1 px-4 my-4 rounded-5 shadow-sm" id="generate-pdf-btn"  style="height: 30px; font-size: 12px;" onclick="window.print()">Print</button> -->
                            </div>
                            <div class="d-flex">
                                <button class="btn btn-success px-4 text-white shadow-sm rounded-5" type="submit" style="height: 40px; margin-top: 25px;">Search</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
