        let ttts = '.total_sta';

        let pps = '.price_sta';
        let tps = '.totalPriceSta'

        let ppf = '.price_fac'
        let tpf = '.totalPriceFac';

        let ppfs = '.proFitSta';
        let tpfs = '.totalProfitSta'

        let pff = '.proFitFac';
        let tpff = '.totalProfitFac'
        
        setTimeout(function() {
            // paper
            processCalc(pd, ptd);
            processCalc(ppd1, tpd1);
            processCalc(ps, pts);
            processCalc(pps1, tps1);
            processCalc(ppf1, tpf1);
            processCalc(ppfs1, tpfs1);
            processCalc(pff1, tpff1);
            // gross
            processCalc(gd, gtd);
            processCalc(ppd2, tpd2);
            processCalc(gs, gts);
            processCalc(pps2, tps2);
            processCalc(ppf2, tpf2);
            processCalc(ppfs2, tpfs2);
            processCalc(pff2, tpff2);
            // oil
            processCalc(od, otd);
            processCalc(ppd3, tpd3);
            processCalc(os, ots);
            processCalc(pps3, tps3);
            processCalc(ppf3, tpf3);
            processCalc(ppfs3, tpfs3);
            processCalc(pff3, tpff3);
            // other
            processCalc(d, td);
            processCalc(ppd4, tpd4);
            processCalc(s, ts);
            processCalc(pps4, tps4);
            processCalc(ppf4, tpf4);
            processCalc(ppfs4, tpfs4);
            processCalc(pff4, tpff4);

            // Plastic
            processCalc(psd, pstd);
            processCalc(ppd5, tpd5);
            processCalc(pss, psts);
            processCalc(pps5, tps5);
            processCalc(ppf5, tpf5);
            processCalc(ppfs5, tpfs5);
            processCalc(pff5, tpff5);

