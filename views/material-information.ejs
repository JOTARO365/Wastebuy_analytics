<script>
    $(document).ready(function() {

        function processCalc(part, totalPart) {
            var total = 0;
            $(part).each(function() {
                // ต้องใช้ /,/g — replace(',','') ตัดลูกน้ำแค่ตัวแรก ค่าเกินหลักล้านจะถูกตัดทิ้ง
                let weightText = $(this).text().trim().replace(/,/g,'')
                let replaceText = weightText.replace(/.*\((.*?)\).*/, '$1');
                let weight = parseFloat(replaceText) || 0 ;

                total += weight;
                
            })
            $(totalPart).html(total.toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}));
            
        }

        // ยอดรวมรายคลัง — จำนวนคลังไม่คงที่ (มาจากข้อมูลจริงของช่วงที่เลือก)
        // จับคู่ด้วยชื่อคลาสทีละตัวแบบคอลัมน์อื่นไม่ได้ จึงรวมตามลำดับคอลัมน์
        // ภายในบล็อกหมวดเดียวกันแทน
        ['Paper', 'Glass', 'Oil', 'Other', 'Plastic', 'Metal1', 'Metal2'].forEach(function (group) {
            const rows = document.querySelectorAll('.item' + group);
            const sumRow = document.querySelector('.sum' + group);
            if (!rows.length || !sumRow) return;

            sumRow.querySelectorAll('.total_by_sta').forEach(function (cell, i) {
                let total = 0;
                rows.forEach(function (row) {
                    const c = row.querySelectorAll('.kg_by_sta')[i];
                    if (c) total += parseFloat(c.innerText.replace(/,/g, '')) || 0;
                });
                cell.innerText = total.toLocaleString(undefined,
                    { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            });
        });

        //Paper
        let pd = '.kg_deli1';
        let ptd = '.total_deli1';

        let ppd1 = '.price_deli1';
        let tpd1 = '.totalPriceDeli1';

