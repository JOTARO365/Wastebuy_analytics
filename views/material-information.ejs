<style>
    .scroll-content {
        overflow-x: hidden;
    }
        
    @media print {
        body .no-print {
            display: none !important;
        }

        .scroll-content {
            overflow-x: hidden;
        }
        .section-2 {
            page-break-after: always;
        }
        .section-3 {
            page-break-after: always;
        }
        .section-4 {
            page-break-after: always;
        }
        .section-5 {
            page-break-after: always;
