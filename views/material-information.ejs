            var total = 0;
            $(part).each(function() {
                let weightText = $(this).text().trim().replace(',','')
                let replaceText = weightText.replace(/.*\((.*?)\).*/, '$1');
                let weight = parseFloat(replaceText) || 0 ;

                total += weight;
                
            })
            $(totalPart).html(total.toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}));
            
        }
