            </div><!-- /#content -->
        </div><!-- /.wb-main -->
    </div><!-- /.wb-shell -->

<!-- กล่องยืนยันกลาง ใช้แทน confirm() ของเบราว์เซอร์ทุกหน้า
     confirm() บล็อกทั้งหน้าไว้ หน้าตาต่างกันทุกเบราว์เซอร์ และใส่รายละเอียดไม่ได้ -->
<div class="modal fade" id="wb-confirm" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="wb-confirm-title">ยืนยัน</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        aria-label="ปิด"></button>
            </div>
            <div class="modal-body">
                <p id="wb-confirm-message" class="mb-2"></p>
                <ul id="wb-confirm-detail" class="wb-confirm-detail"></ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm"
                        data-bs-dismiss="modal">ยกเลิก</button>
                <button type="button" class="btn btn-danger btn-sm" id="wb-confirm-ok">
                    ยืนยัน
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    #wb-confirm .modal-header { border-bottom: 0; padding-bottom: .25rem; }
    #wb-confirm .modal-footer { border-top: 0; padding-top: .25rem; }
    #wb-confirm .modal-title { font-size: 1.05rem; font-weight: 600; }
    #wb-confirm-message { font-size: .92rem; }
    .wb-confirm-detail {
        list-style: none;
        margin: 0;
        padding: .6rem .8rem;
        background: #f6f8f7;
        border-radius: .4rem;
        font-size: .84rem;
        color: #5a6b63;
    }
    .wb-confirm-detail:empty { display: none; }
    .wb-confirm-detail li { padding: .12rem 0; }
    .wb-confirm-detail li::before { content: '·'; margin-right: .4rem; }
</style>

<script>
    // ── สถานะกำลังโหลด ────────────────────────────────────────────
    // ค้นหารายงานคือการโหลดหน้าใหม่ ซึ่งกินเวลาหลายวินาทีเมื่อช่วงวันที่กว้าง
    // ระหว่างนั้นเบราว์เซอร์ยังแสดงหน้าเดิม กดซ้ำได้ และไม่มีอะไรบอกว่ารับคำสั่งแล้ว
    (function () {
        const overlay = document.getElementById('page-loading');
        const label = document.getElementById('page-loading-text');
        if (!overlay) return;

        let shown = false;
        function showLoading(message) {
            if (shown) return;
            shown = true;
            if (message) label.textContent = message;
            overlay.dataset.visible = 'true';
            overlay.setAttribute('aria-hidden', 'false');
        }

        function hideLoading() {
            shown = false;
            overlay.dataset.visible = 'false';
            overlay.setAttribute('aria-hidden', 'true');
            document.querySelectorAll('button[type="submit"][disabled]')
                .forEach(function (b) { b.disabled = false; });
        }

        document.addEventListener('submit', function (e) {
            const form = e.target;
            if (!(form instanceof HTMLFormElement) || form.noValidate === false && !form.checkValidity()) return;
            showLoading('กำลังดึงข้อมูล...');
            // กันกดซ้ำระหว่างรอ แต่ปล่อยให้ค่าถูกส่งไปก่อน
            setTimeout(function () {
                form.querySelectorAll('button[type="submit"]').forEach(function (b) { b.disabled = true; });
            }, 0);
        }, true);

        // ลิงก์เปลี่ยนหน้า (แบ่งหน้า / เมนูซ้าย) ก็ใช้เวลาเท่ากัน
        document.addEventListener('click', function (e) {
            const link = e.target.closest('a[href]');
            if (!link || link.target === '_blank' || e.metaKey || e.ctrlKey || e.shiftKey) return;
            const href = link.getAttribute('href');
            if (!href || href.startsWith('#') || href.startsWith('javascript:')) return;
            // ลิงก์ในแผนที่กับใน modal ไม่ได้พาไปหน้าใหม่ ถ้าโชว์ overlay จะค้างถาวร
            if (link.closest('.leaflet-container, .modal, .dropdown-menu')) return;
            showLoading('กำลังเปิดหน้า...');

            // กันเหนียว: ถ้า 8 วินาทีแล้วยังอยู่หน้าเดิม แปลว่าไม่ได้ไปไหน
            // ปล่อยให้ overlay ค้างคือทำให้หน้าใช้ไม่ได้ทั้งหน้าโดยไม่มีทางออก
            setTimeout(function () {
                if (!document.hidden) hideLoading();
            }, 8000);
        });

        // กลับมาด้วยปุ่ม Back เบราว์เซอร์คืนหน้าจาก cache — ต้องซ่อน overlay ทิ้ง
        window.addEventListener('pageshow', hideLoading);
        // Esc ต้องพาออกจาก overlay ได้เสมอ เผื่อกรณีที่ยังคิดไม่ถึง
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') hideLoading();
        });

        window.addEventListener('beforeprint', function () {
            overlay.dataset.visible = 'false';
        });
    })();

    // ── แถบกรอง: ไม่ส่ง key ที่ไม่ได้เลือก ────────────────────────
    // GET form ส่งทุก input เสมอ URL จึงเต็มไปด้วย ?district=&channel=&ring=
    // ทำให้ลิงก์แชร์กันอ่านไม่ออก และ back/forward เพี้ยน
    document.addEventListener('submit', function (e) {
        const form = e.target;
        if (!(form instanceof HTMLFormElement) || !form.hasAttribute('data-wb-filter')) return;
        form.querySelectorAll('input, select').forEach(function (el) {
            if (el.type === 'checkbox') {
                if (!el.checked) el.disabled = true;
            } else if (!el.value) {
                el.disabled = true;
            }
        });
    });

    // ── export ตารางเป็น CSV ──────────────────────────────────────
    // เอาจาก DOM ตรง ๆ เพื่อให้ได้เฉพาะแถวที่กรองแล้ว ตรงกับที่ตาเห็น
    document.addEventListener('click', function (e) {
        const btn = e.target.closest('[data-wb-export]');
        if (!btn) return;

        const selector = btn.getAttribute('data-wb-export');
        const table = selector ? document.querySelector(selector)
                               : document.querySelector('.wb-table');
        if (!table) { window.notify('ไม่พบตารางที่จะ export'); return; }

        const rows = [];
        table.querySelectorAll('tr').forEach(function (tr) {
            const cells = [];
            tr.querySelectorAll('th, td').forEach(function (cell) {
                const text = (cell.innerText || '').replace(/\s+/g, ' ').trim();
                cells.push('"' + text.replace(/"/g, '""') + '"');
            });
            if (cells.length) rows.push(cells.join(','));
        });

        // BOM ไม่ใช่ของประดับ — Excel บน Windows อ่าน UTF-8 ไม่ออกถ้าไม่มี
        // แล้วภาษาไทยจะกลายเป็นอักขระขยะทั้งไฟล์
        const blob = new Blob(['﻿' + rows.join('\r\n')],
                              { type: 'text/csv;charset=utf-8;' });
        const link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = (document.title.split('·')[0] || 'export').trim() + '.csv';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(link.href);
    });


    // ── กล่องยืนยัน ───────────────────────────────────────────────
    // ใช้แทน confirm() — คืน Promise<boolean> เรียกด้วย await ได้เหมือนเดิม
    //   if (!await wbConfirm({ title: '...', message: '...' })) return;
    window.wbConfirm = function (options) {
        const el = document.getElementById('wb-confirm');
        if (!el || typeof bootstrap === 'undefined') {
            // ไม่มี modal ให้ใช้ (หน้าเก่า/สคริปต์ยังไม่โหลด) ถอยไปใช้ของเบราว์เซอร์
            return Promise.resolve(window.confirm(options.message || 'ยืนยัน?'));
        }

        const opts = options || {};
        document.getElementById('wb-confirm-title').textContent = opts.title || 'ยืนยัน';
        document.getElementById('wb-confirm-message').textContent = opts.message || '';

        const detail = document.getElementById('wb-confirm-detail');
        detail.innerHTML = '';
        (opts.detail || []).forEach(function (line) {
            const li = document.createElement('li');
            li.textContent = line;
            detail.appendChild(li);
        });

        const okBtn = document.getElementById('wb-confirm-ok');
        okBtn.textContent = opts.confirmText || 'ยืนยัน';
        okBtn.className = 'btn btn-sm ' +
            (opts.danger === false ? 'btn-success' : 'btn-danger');

        const modal = bootstrap.Modal.getOrCreateInstance(el);

        return new Promise(function (resolve) {
            let answered = false;

            function done(value) {
                if (answered) return;
                answered = true;
                okBtn.removeEventListener('click', onOk);
                el.removeEventListener('hidden.bs.modal', onHide);
                resolve(value);
            }
            function onOk() { modal.hide(); done(true); }
            // ปิดด้วยกากบาท/ปุ่มยกเลิก/Esc ทุกทางถือว่าไม่ยืนยัน
            function onHide() { done(false); }

            okBtn.addEventListener('click', onOk);
            el.addEventListener('hidden.bs.modal', onHide);
            modal.show();
        });
    };

    // ── แจ้งเตือนแบบไม่บล็อก ──────────────────────────────────────
    // alert() หยุดทั้งหน้าไว้จนกว่าจะกดปิด และทำให้สคริปต์อัตโนมัติค้าง
    window.notify = function (message, ms) {
        const area = document.getElementById('toast-area');
        if (!area) return;
        const item = document.createElement('div');
        item.className = 'toast-msg';
        item.textContent = message;
        area.appendChild(item);
        setTimeout(function () { item.remove(); }, ms || 4000);
    };
</script>
</body>
</html>
