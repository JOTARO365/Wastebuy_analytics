<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Wastebuy Automate' %></title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg==" crossorigin="anonymous" referrerpolicy="no-referrer">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="/styles/stylesheet.css">

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.0.0/dist/chartjs-plugin-datalabels.min.js"></script>
    <style>
        /* รายงานบางช่วงใช้เวลาหลายวินาที ระหว่างนั้นหน้าเดิมยังค้างอยู่บนจอ
           ไม่มีอะไรบอกว่ากดติดแล้ว — overlay นี้ตอบทันทีที่กด */
        #page-loading {
            position: fixed;
            inset: 0;
            z-index: 2000;
            display: none;
            place-items: center;
            background: rgba(255, 255, 255, .78);
            backdrop-filter: blur(1px);
        }
        #page-loading[data-visible="true"] { display: grid; }
        #page-loading .box {
            display: flex;
            align-items: center;
            gap: .9rem;
            padding: 1rem 1.6rem;
            background: #fff;
            border: 1px solid #d5ded9;
            border-radius: .5rem;
            box-shadow: 0 8px 28px rgba(0, 0, 0, .12);
            font-size: .95rem;
        }
        #page-loading .ring {
            width: 22px;
            height: 22px;
            flex: none;
            border: 3px solid #cfe3d8;
            border-top-color: #198754;
            border-radius: 50%;
            animation: page-loading-spin .8s linear infinite;
        }
        @keyframes page-loading-spin { to { transform: rotate(360deg); } }
        @media (prefers-reduced-motion: reduce) {
            #page-loading .ring { animation-duration: 2.4s; }
        }

        /* แจ้งเตือนแบบไม่บล็อกหน้าจอ ใช้แทน alert() */
        #toast-area {
            position: fixed;
            top: 1rem;
            left: 50%;
            transform: translateX(-50%);
            z-index: 2100;
            display: flex;
            flex-direction: column;
            gap: .5rem;
            pointer-events: none;
        }
        #toast-area .toast-msg {
            background: #332a1a;
            color: #fff;
            padding: .6rem 1rem;
            border-radius: .4rem;
            border-left: 4px solid #ffc107;
            box-shadow: 0 6px 20px rgba(0, 0, 0, .2);
            font-size: .9rem;
            max-width: 90vw;
        }
    </style>
</head>
<body class="scroll-content">
    <div id="page-loading" aria-hidden="true">
        <div class="box" role="status" aria-live="polite">
            <span class="ring"></span>
            <span id="page-loading-text">กำลังดึงข้อมูล...</span>
        </div>
    </div>
    <div id="toast-area" role="status" aria-live="polite"></div>
    <div class="d-flex">
        <nav class="d-flex flex-column justify-content-center shadow-sm bg-success no-print" style="width: 300px; height: auto;">
            <div class="shadow-sm bg-white">
                <a href="/" class="d-flex justify-content-center"><img src="/images/logo3.png" height="180" alt="Wastebuy"></a>
                <div class="d-flex justify-content-center text-center">
                    <h4 class="fw-bold text-success p-1">Wastebuy Automate</h4>
                </div>
            </div>
            <ul class="list-unstyled d-flex flex-grow-1 flex-column mb-auto mt-4 fs-6">
                <li class="nav-link">
                    <span class="d-flex justify-content-center p-2 mb-3 text-center text-white-50">Report Customer <br> (ยังไม่เปิดใช้)</span>
                </li>
                <li class="nav-link">
                    <a class="d-flex justify-content-center p-2 mb-3 text-center" href="/Scheduling-system">Scheduling System <br> จัดคิวรถเข้ารับวัสดุ</a>
                </li>
                <li class="nav-link">
                    <a class="d-flex justify-content-center p-2 mb-3 text-center" href="/material-information">Material Information <br> รายงานรับซื้อวัสดุ</a>
                </li>
                <li class="nav-link">
                    <a class="d-flex justify-content-center p-2 mb-3 text-center" href="/report-50-Districts">Report 50 Districts <br> รายงานน้ำหนัก 50 เขต</a>
                </li>
                <li class="nav-link">
                    <a class="d-flex justify-content-center p-2 mb-3 text-center" href="/report-carbon-credit">Report Carbon Credit <br> รายงานยอดคาร์บอนเครดิตตามชื่อสมาชิก</a>
                </li>
                <li class="nav-link">
                    <a class="d-flex justify-content-center p-2 mb-3 text-center" href="/report-customer-details-materials">Report Customer <br> Details Material <br> รายงานรับซื้อวัสดุ และ กลุ่มสมาชิก</a>
                </li>
            </ul>
        </nav>
        <div class="container-fluid">
            <div class="d-flex border-bottom border-3 border-success justify-content-end mx-3 no-print" style="height: 72px; width: 95%;"></div>
            <div id="content">
