<html>
    <style>
        
    </style>
<body>
    <div class="container">
        <div class="content row px-4">
            <div class="col-lg-3 col-xxl-2 col-sm-12 logo">
                <img src="/public/images/logo3.png" height="150" alt="">
            </div>
            <div class="col-lg-9 col-xxl-10 col-sm-12 text">
                <h2 class="fs-1 fw-bold text-success">Wastebuy Delivery Co,. Ltd.</h2>
            <div class="mt-2 lead">
                <p class="fs-4">Report Customer Details materials</p>
                <p class="fs-5">สรุปยอดเข้ารับวัสดุ กลุ่มลูกค้า : </p>
                <p class="fs-5 "> ตั้งแต่วันที่  <%= startDate  %> ถึงวันที่ <%= endDate %></p>
            </div>
        </div>
        <div class="container print">
            <div class="container-fluid p-1">
                <div class="row" style="width: 100%; height: 510px;">
                    <div class="col-lg-6 col-md-12 py-2" style="width: 50%; height: 50%;">
                        <span >การลดการปล่อยก๊าซเรือนกระจก / เดือน</span>
                        <canvas id="ghgGroupChart"><canvas>
                    </div>
                    <div class="col-lg-6 col-md-12 py-2" style="width: 50%; height: 50%;">
                        <span >ปริมาณน้ำหนักสุทธิกลุ่มวัสดุ</span>
                        <canvas id="matGroupChart"></canvas>
                    </div>
                    <div class="col-lg-6 col-md-12 py-2" style="width: 50%; height: 50%;">
                        <span >ปริมาณน้ำหนักสุทธิเดือน / เดือน</span>
                        <canvas id="weightGroupChart"></canvas>
                    </div>
                    <div class="col-lg-6 col-md-12 py-2" style="width: 50%; height: 50%;">
                        <span >ปริมาณรับซื้อสุทธิเดือน / เดือน</span>
                        <canvas id="priceGroupChart"></canvas>
                    </div>
                    <div class="col-12 p-2" style="font-size: 10px; height: 30%;">
                        <div class="d-grid bg-success rounded-top text-center text-white py-2" style="grid-template-columns: 5% 24% 14% 28% 15% 14%; ">
                            <div class="">No.</div>
                            <div class="">Customer</div>
                            <div >Carbon Credits</div>
                            <div >Materials</div>
                            <div class="text-center">Weight ( กก. )</div>
                            <div class="text-center">Price ( บาท )</div>
                        </div>
                        <div class="d-grid bg-success text-white text-center py-2" style="grid-template-columns:5% 24% 7% 7% repeat(7, 4%) 15% 14%; font-size: 8px; ">
                            <div ></div>
                            <div ></div>
                            <div>GHG</div>
                            <div>TREE</div>
                            <div >กระดาษ</div>
                            <div >แก้ว</div>
                            <div >พลาสติก</div>
                            <div >โลหะมีค่า</div>
                            <div >เหล็ก</div>
                            <div >น้ำมัน</div>
                            <div >เบ็ตเตล็ด</div>
                            <div></div>
                            <div></div>
                        </div>
                        <div id="content-customer" style="height: auto;"></div>
                    </div>
                    <div class="col-5">
                       
                    </div>
                </div>
              </div>
        </div>               
    </div> 
</body>
</html>