<%- include('partials/header') %>

<style>
    .wb-launcher {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    }
    .wb-launch {
        display: flex;
        gap: .9rem;
        align-items: flex-start;
        background: var(--wb-surface);
        border: 1px solid var(--wb-border);
        border-radius: var(--wb-radius);
        box-shadow: var(--wb-shadow-sm);
        padding: 1.1rem;
        text-decoration: none;
        color: inherit;
        transition: transform .12s ease, box-shadow .12s ease, border-color .12s ease;
    }
    .wb-launch:hover {
        transform: translateY(-2px);
        box-shadow: var(--wb-shadow);
        border-color: var(--wb-green);
        color: inherit;
    }
    .wb-launch .icon {
        width: 2.4rem;
        height: 2.4rem;
        flex: none;
        display: grid;
        place-items: center;
        border-radius: var(--wb-radius-sm);
        background: var(--wb-green-soft);
        color: var(--wb-green-dark);
        font-size: 1.05rem;
    }
    .wb-launch .title { font-weight: 600; }
    .wb-launch .desc { font-size: .84rem; color: var(--wb-ink-soft); }
</style>

<%- include('partials/page-head', {
        heading: 'Wastebuy Delivery Co., Ltd.',
        lead: 'ศูนย์รวมรายงานและการวิเคราะห์'
    }) %>

<div class="wb-body">
    <% nav.forEach(function (section) { %>
        <h3 class="wb-card-title mt-2"><%= section.group %></h3>
        <div class="wb-launcher mb-4">
            <% section.items.forEach(function (item) { %>
                <a class="wb-launch" href="<%= item.path %>">
                    <span class="icon"><i class="fa-solid <%= item.icon %>" aria-hidden="true"></i></span>
                    <span>
                        <span class="title d-block"><%= item.title %></span>
                        <span class="desc"><%= item.subtitle %></span>
                    </span>
                </a>
            <% }) %>
        </div>
    <% }) %>
</div>

<%- include('partials/footer') %>
