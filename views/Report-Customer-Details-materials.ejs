<style>
@media print {
    body .no-print {
        display: none !important;
    }

    @page {
        size: A4 portrait;
        margin: 20mm;
    }
    
    .logo {
        align-items: center;
    }
    .logo img {
        display: block;
        margin: 0 auto; /* จัดรูปภาพให้อยู่ตรงกลาง */
    }
    /* บังคับให้มีการแบ่งหน้าให้แผนภูมิไปอยู่ที่หน้า 2 */

    .section-1 {
        page-break-before: always;
    }

    #chartMaterial {
        position: relative;
        right: -33%;
        top: 20px;
        width: 400px;
        height: 400px;
    }

    /* ซ่อนองค์ประกอบที่ไม่จำเป็นในการพิมพ์ */
    .no-print, button, .modal {
        display: none !important;
    }

    /* ปรับขนาดของแผนภูมิให้พอดีกับหน้ากระดาษ */
    .chart-section {
        page-break-inside: avoid; /* ป้องกันการแบ่งแผนภูมิเป็นสองหน้า */
        position: relative;
        top: 50px;
        margin: 20px 0; /* เพิ่มพื้นที่ว่างรอบๆ */
        width: 100%; /* ปรับขนาดให้เต็มหน้ากระดาษ */
        height: auto; /* ให้ความสูงอัตโนมัติ */
    }


    .chart-section .chart-bar {
        position: relative;
        margin-top: -200px; /* ปรับให้ติดกับ mainchart */
        height: 200px; /* ลดความสูงของ chart-bar เพื่อให้เห็นข้อมูลทั้งหมด */
        width: 100%; /* ให้ chart-bar ใช้พื้นที่ทั้งหมด */
    }

    .chart-section .chart-bar {
        position: relative;
        margin-top: -50px; /* เลื่อนขึ้นมา 50px หรือปรับตามความต้องการ */
        height: auto; /* ปรับความสูงให้เหมาะสม */
        width: 100%; /* ให้ chart-bar ใช้พื้นที่ทั้งหมด */
    }

    .chart-section .chart-bar canvas {
        width: 100% !important; /* ให้ canvas ใช้ความกว้างเต็มที่ */
        height: 120% !important; /* ให้ canvas ใช้ความสูงเต็มที่ */
        position: relative; /* ตั้งค่าตำแหน่งให้สัมพันธ์กับ parent */
        top: -150px; /* เลื่อน canvas ขึ้น 50px หรือปรับตามความต้องการ */
    }

    /* ปรับตารางและฟอนต์สำหรับพิมพ์ */
    .header-content, .body-content {
        grid-template-columns: 80px 1.5fr 1fr 1fr 1fr 1fr !important;
    }
    .scroll-content {
        width: calc(100% + 35px); /* เพิ่มขนาดความกว้างของเนื้อหา */
        overflow-y: scroll;
    }

    .scroll-content::-webkit-scrollbar {
        display: none;
    }

    .chart-section .chart-bar {
        position: relative;
        top: -500px;
    }

    #SubPieChart {
        max-width: 400px; 
        max-height: 400px;
        position: relative;
        top: 60px;
    }
    
}        

</style>

