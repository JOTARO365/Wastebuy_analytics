document.getElementById('export-excel').addEventListener('click', function() {
    // เลือก container ที่เก็บข้อมูล
    const table = document.querySelector('.scroll-content');
    const tableItem = document.querySelector('.item-content');

    // เลือกแถวของตาราง
    const rows = table.querySelectorAll('.body-content-group');
    const rowsDetail = tableItem.querySelectorAll('.body-content');

    // สร้าง array สำหรับเก็บข้อมูล
    const data = [['No.', 'Groups', 'Weight', 'GHG', 'Tree']];
    const dataDetail = [['No', 'Date', 'Customer', 'Group', 'Weight', 'Price ( บาท )', 'GHG', 'Tree']];

    // ดึงข้อมูลจากแต่ละแถว
    rows.forEach(row => {
        const cells = row.querySelectorAll('div');
        const rowData = Array.from(cells).map(cell => cell.textContent.trim());
        data.push(rowData);
    });

    // ดึงข้อมูลจากแถวรายละเอียด
    rowsDetail.forEach(row => {
        const cells = row.querySelectorAll('div');
        const rowData = Array.from(cells).map((cell, index) => {
            let cellValue = cell.textContent.trim();
            if (index === 1) {
                cellValue = `${cellValue}`;
            }
            return cellValue;
        });
        dataDetail.push(rowData);
    });

    // สร้าง workbook และ worksheet
    const wb = XLSX.utils.book_new();
    const ws = XLSX.utils.aoa_to_sheet(data);

    // เพิ่มบรรทัดว่างสองบรรทัด
    XLSX.utils.sheet_add_aoa(ws, [[''], ['']], { origin: -1 });

    // เพิ่มข้อมูล dataDetail หลังบรรทัดว่าง
    XLSX.utils.sheet_add_aoa(ws, dataDetail, { origin: -1 });

    XLSX.utils.book_append_sheet(wb, ws, 'Sheet1');

    // สร้าง blob ของ Excel
    const wbout = XLSX.write(wb, { bookType: 'xlsx', type: 'binary' });

    // ฟังก์ชันสำหรับแปลง binary เป็น array buffer
    function s2ab(s) {
        const buf = new ArrayBuffer(s.length);
        const view = new Uint8Array(buf);
        for (let i = 0; i < s.length; i++) view[i] = s.charCodeAt(i) & 0xFF;
        return buf;
    }

    // ดาวน์โหลดไฟล์
    const filename = 'รายการรับซื้อวัสดุแบ่งตามกลุ่มสมาชิก.xlsx';
    const link = document.createElement('a');
    link.href = URL.createObjectURL(new Blob([s2ab(wbout)], { type: 'application/octet-stream' }));
    link.download = filename;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
});

function processCalc(part, totalPart) {
            var total = 0;
            $(part).each(function() {
                // ต้องใช้ /,/g — replace(',','') ตัดลูกน้ำแค่ตัวแรก ค่าเกินหลักล้านจะถูกตัดทิ้ง
                let weightText = $(this).text().trim().replace(/,/g,'')
                let replaceText = weightText.replace(/.*\((.*?)\).*/, '$1');
                let weight = parseFloat(replaceText) || 0 ;

                total += weight;

            })
            $(totalPart).html(total.toLocaleString());

};


