// กรองข้อมูลเพื่อรวมกลุ่มลูกค้าที่ขึ้นต้นด้วย B2B หรือ B2C
const b2bAndB2cData = totalsData.filter(item => 
    item.customer_group !== null && 
    (item.customer_group.startsWith('B2B') || item.customer_group.startsWith('B2C'))
);

// จัดลำดับข้อมูลโดยให้กลุ่มลูกค้า B2C มาก่อน
const sortedData = b2bAndB2cData.sort((a, b) => {
    if (a.customer_group.startsWith('B2C') && !b.customer_group.startsWith('B2C')) {
        return -1;
    } else if (!a.customer_group.startsWith('B2C') && b.customer_group.startsWith('B2C')) {
        return 1;
    }
    return 0;
});

// จัดกลุ่มและรวมข้อมูลที่ซ้ำกัน
const uniqueCustomerGroups = [];
const aggregatedWeights = [];

sortedData.forEach(item => {
    const groupName = item.customer_group.startsWith('B2B') ? 'ลูกค้า B2B' : 'ลูกค้า B2C';
    const index = uniqueCustomerGroups.indexOf(groupName);
    
    if (index === -1) {
        // ถ้ายังไม่มีใน uniqueCustomerGroups ให้เพิ่มและเพิ่มน้ำหนัก
        uniqueCustomerGroups.push(groupName);
        aggregatedWeights.push(item.kg_delivery);
    } else {
        // ถ้ามีกลุ่มนี้อยู่แล้ว ให้รวมข้อมูลน้ำหนัก
        aggregatedWeights[index] += item.kg_delivery;
    }
});

// กำหนดสีสำหรับแต่ละกลุ่มลูกค้า
const backgroundColors = uniqueCustomerGroups.map(group => {
    return group === 'ลูกค้า B2B' ? 'rgba(255, 159, 64, 0.5)' : 'rgba(54, 162, 235, 0.5)';
});

