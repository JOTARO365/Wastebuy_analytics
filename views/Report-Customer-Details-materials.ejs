function showDetails(event) {
    event.preventDefault();

    const target = event.currentTarget;
    const purchaseNumber = target.getAttribute('data-purchase-number');
    const purchaseDate = target.getAttribute('data-purchase-date');
    const location = target.getAttribute('data-location');
    const customerGroup = target.getAttribute('data-customer-group');

    document.getElementById('purchaseNumberDetails').textContent = `Purchase Number : ${purchaseNumber}`;
    document.getElementById('purchaseDateDetails').textContent = `ประจำวันที่ : ${purchaseDate}`;
    document.getElementById('location').textContent =  `ลูกค้า : ${location}`;
    document.getElementById('customerGroup').textContent = `กลุ่มสมาชิก : ${customerGroup}`;

    const filterMaterials = materialData.filter(item => item.purchase_number === purchaseNumber);

    const materialDetails = document.querySelector('.modal-body .content-item')
    materialDetails.innerHTML = '';

    if (filterMaterials.length > 0) {
        filterMaterials.slice(1).forEach(material => {
            const row = document.createElement('div');
            row.className = 'row border-bottom border-end border-start py-1';

            row.innerHTML = `
                <div class="col">${material.item_name}</div>
                <div class="col modal_kg">${material.kg_delivery.toFixed(2)}</div>
                <div class="col modal_price">${material.total_delivery.toFixed(2)}</div>
                <div class="col modal_ghg">${material.ghg.toFixed(2)}</div>
                <div class="col modal_tree">${parseInt(material.ghg / 9.5)}</div>
            `
            materialDetails.appendChild(row);
        })
        let kg = '.modal_kg';
        let ghg = '.modal_ghg';
        let tree = '.modal_tree';
        let price = '.modal_price';

        let totalkg = '.modal_kgTotal';
        let totalGhg = '.modal_ghgTotal';
        let totalTree = '.modal_treeTotal';
        let totalprice = '.modal_pricetotal';

        setTimeout(function() {
            processCalc(kg, totalkg);
            processCalc(ghg, totalGhg);
            processCalc(tree, totalTree);
            processCalc(price, totalprice)
        },500)
    }

    const data = filterMaterials.slice(1).map(item => item.kg_delivery);
    const labels = filterMaterials.slice(1).map(item => item.item_name);

    const chartData = {
    labels: labels,
    datasets: [{
        data: data,
        backgroundColor: [
        'rgb(255, 99, 132)',   // สีแดง
        'rgb(54, 162, 235)',   // สีน้ำเงิน
        'rgb(255, 205, 86)',   // สีเหลือง
        'rgb(75, 192, 192)',   // สีเขียวฟ้า
        'rgb(153, 102, 255)',  // สีม่วง
        'rgb(255, 159, 64)',   // ส้ม
        'rgb(201, 203, 207)',  // เทา
        'rgb(255, 99, 71)',    // สีแดงเข้ม
        'rgb(123, 239, 178)',  // สีเขียวมิ้น
        'rgb(255, 87, 34)',    // สีส้มแดง
        'rgb(64, 224, 208)',   // สีเขียวอมน้ำเงิน
        'rgb(238, 130, 238)',  // สีม่วงอ่อน
        'rgb(220, 20, 60)',    // สีแดงเข้ม
        'rgb(0, 191, 255)',    // สีฟ้าเข้ม
        'rgb(34, 139, 34)',    // สีเขียวเข้ม
        'rgb(51, 212, 13)',    // สีเขียวสด
        'rgb(128, 0, 128)',    // สีม่วง
        'rgb(255, 105, 180)',  // สีชมพู
        'rgb(255, 140, 0)',    // สีส้มเข้ม
        'rgb(0, 255, 255)'     // สีฟ้าเขียว
        ],
        label: '(kg)',
        hoverOffset: 4
    }]
};

const config = {
    type: 'pie',
    data: chartData,
    options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: {
                display: true,
                position: 'right',
                labels: {
                    font: {
                        family: 'Prompt', // ใช้ฟอนต์ Prompt
                        size: 14 // ขนาดฟอนต์
                    },
                    generateLabels: function (chart) {
                        const data = chart.data;
                        return data.labels.map((label, i) => {
                            const total = data.datasets[0].data.reduce((acc, val) => acc + val, 0);
                            const value = data.datasets[0].data[i];
                            const percentage = (value / total * 100).toFixed(2);
                            return {
                                text: `${label} (${percentage}%)`,
                                fillStyle: data.datasets[0].backgroundColor[i]
                            };
                        });
                    }
                }
            }
        }
    }
};

    const existingChart = Chart.getChart('materialChart');
    if (existingChart) {
        existingChart.destroy();
    }

    const chart = new Chart(
        document.getElementById('materialChart'),
        config
    )

    $('#detailModal').modal('show');
}

