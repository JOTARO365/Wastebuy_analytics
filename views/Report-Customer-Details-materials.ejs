<script>

    const totalsData = <%- JSON.stringify(totals) %>;
    const materialData = <%- JSON.stringify(matDetail) %>;


    const filteredData = totalsData.filter(item => item.customer_group !== null);

    const labels = filteredData.map(item => item.customer_group);
    const data = filteredData.map(item => item.kg_delivery);

    const chartData = {
        labels: labels,
        datasets: [{
            data: data,
            backgroundColor: [
                'rgb(255, 99, 132)',
                'rgb(54, 162, 235)',
                'rgb(255, 205, 86)',
                'rgb(75, 192, 192)',
                'rgb(153, 102, 255)',
                'rgb(255, 159, 64)'
            ],
            label: '(kg)',
            hoverOffset: 4
        }]
    };

   
    const config = {
        type: 'pie',
        data: chartData,
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'right'
                }
            }
        }
    };

    const myPieChart = new Chart(
        document.getElementById('MainPieChart'),
        config
    );

// กรองข้อมูลเพื่อรวมกลุ่มลูกค้าที่ขึ้นต้นด้วย B2B หรือ B2C
const b2bAndB2cData = totalsData.filter(item => 
    item.customer_group !== null && 
    (item.customer_group.startsWith('B2B') || item.customer_group.startsWith('B2C'))
);

// จัดลำดับข้อมูลโดยให้กลุ่มลูกค้า B2C มาก่อน
const sortedData = b2bAndB2cData.sort((a, b) => {
    if (a.customer_group.startsWith('B2C') && !b.customer_group.startsWith('B2C')) {
        return -1;
    } else if (!a.customer_group.startsWith('B2C') && b.customer_group.startsWith('B2C')) {
        return 1;
    }
    return 0;
});

// จัดกลุ่มและรวมข้อมูลที่ซ้ำกัน
const uniqueCustomerGroups = [];
const aggregatedWeights = [];

sortedData.forEach(item => {
    const groupName = item.customer_group.startsWith('B2B') ? 'ลูกค้า B2B' : 'ลูกค้า B2C';
    const index = uniqueCustomerGroups.indexOf(groupName);
    
    if (index === -1) {
        // ถ้ายังไม่มีใน uniqueCustomerGroups ให้เพิ่มและเพิ่มน้ำหนัก
        uniqueCustomerGroups.push(groupName);
        aggregatedWeights.push(item.kg_delivery);
    } else {
        // ถ้ามีกลุ่มนี้อยู่แล้ว ให้รวมข้อมูลน้ำหนัก
        aggregatedWeights[index] += item.kg_delivery;
    }
});

// กำหนดสีสำหรับแต่ละกลุ่มลูกค้า
const backgroundColors = uniqueCustomerGroups.map(group => {
    return group === 'ลูกค้า B2B' ? 'rgba(255, 159, 64, 0.5)' : 'rgba(54, 162, 235, 0.5)';
});

const chartDatab2bb2c = {
    labels: uniqueCustomerGroups,
    datasets: [{
        data: aggregatedWeights,
        backgroundColor: backgroundColors,
        label: '(kg)',
        hoverOffset: 4
    }]
};

const configs = {
    type: 'doughnut',
    data: chartDatab2bb2c,
    options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: {
                position: 'right'
            }
        }
    }
};

// สร้างแผนภูมิ Doughnut
const myPieCharts = new Chart(
    document.getElementById('SubPieChart'),
    configs
);

function showDetails(event) {
    event.preventDefault();

    const target = event.currentTarget;
    const purchaseNumber = target.getAttribute('data-purchase-number');
    const purchaseDate = target.getAttribute('data-purchase-date');
    const location = target.getAttribute('data-location');
    const customerGroup = target.getAttribute('data-customer-group');

    document.getElementById('purchaseNumberDetails').textContent = `Purchase Number : ${purchaseNumber}`;
    document.getElementById('purchaseDateDetails').textContent = `ประจำวันที่ : ${purchaseDate}`;
    document.getElementById('location').textContent =  `ลูกค้า : ${location}`;
    document.getElementById('customerGroup').textContent = `กลุ่มสมาชิก : ${customerGroup}`;

    const filterMaterials = materialData.filter(item => item.purchase_number === purchaseNumber);

    const materialDetails = document.querySelector('.modal-body .content-item')
    materialDetails.innerHTML = '';

    if (filterMaterials.length > 0) {
        filterMaterials.slice(1).forEach(material => {
            const row = document.createElement('div');
            row.className = 'row border-bottom border-end border-start py-1';

            row.innerHTML = `
                <div class="col">${material.item_name}</div>
                <div class="col kg">${material.kg_delivery.toFixed(2)}</div>
                <div class="col ghg">${material.ghg.toFixed(2)}</div>
                <div class="col tree">${parseInt(material.kg_delivery / 9.5)}</div>
            `
            materialDetails.appendChild(row);
        })
        let kg = '.kg';
        let ghg = '.ghg';
        let tree = '.tree';

        let totalkg = '.kgTotal';
        let totalGhg = '.ghgTotal';
        let totalTree = '.treeTotal';
        setTimeout(function() {
            processCalc(kg, totalkg)
            processCalc(ghg, totalGhg)
            processCalc(tree, totalTree)
        },500)
    }

    const data = filterMaterials.slice(1).map(item => item.kg_delivery);
    const labels = filterMaterials.slice(1).map(item => item.item_name);

    const chartData = {
    labels: labels,
    datasets: [{
        data: data,
        backgroundColor: [
        'rgb(255, 99, 132)',   // สีแดง
        'rgb(54, 162, 235)',   // สีน้ำเงิน
        'rgb(255, 205, 86)',   // สีเหลือง
        'rgb(75, 192, 192)',   // สีเขียวฟ้า
        'rgb(153, 102, 255)',  // สีม่วง
        'rgb(255, 159, 64)',   // ส้ม
        'rgb(201, 203, 207)',  // เทา
        'rgb(255, 99, 71)',    // สีแดงเข้ม
        'rgb(123, 239, 178)',  // สีเขียวมิ้น
        'rgb(255, 87, 34)',    // สีส้มแดง
        'rgb(64, 224, 208)',   // สีเขียวอมน้ำเงิน
        'rgb(238, 130, 238)',  // สีม่วงอ่อน
        'rgb(220, 20, 60)',    // สีแดงเข้ม
        'rgb(0, 191, 255)',    // สีฟ้าเข้ม
        'rgb(34, 139, 34)',    // สีเขียวเข้ม
