<%- include('partials/header') %>

<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.0/xlsx.full.min.js"></script>

<style>
    @media print {
        @page {
            size: A4 portrait;
            margins: 0;

        }

        body {
            margin: 0;
        }

        body .no-print {
            display: none !important;
        }

        .logo {
            align-items: center;
        }

        .logo img {
            display: block;
            margin: 0 auto;
        }

    }
</style>
    <div class="container scroll-content ">
        <% if (typeof unknownMaterials !== 'undefined' && unknownMaterials.length) { %>
            <div class="alert alert-warning mx-4 mt-3 no-print">
                <strong>มีวัสดุที่ยังไม่มีค่าแฟกเตอร์คาร์บอน</strong>
                — <%= unknownMaterials.length %> ชื่อ ถูกคิดเป็น 0 ในยอด GHG:
                <%= unknownMaterials.slice(0, 8).map(u => u.item_name).join(' · ') %><%
                    %><% if (unknownMaterials.length > 8) { %> และอีก <%= unknownMaterials.length - 8 %> ชื่อ<% } %>
                <br><span class="small">ตั้งค่า GHG ให้สินค้าเหล่านี้ในระบบ admin แล้ว restart จะหายไปเอง</span>
            </div>
        <% } %>
        <div class="content row py-5 px-4 ">
            <div class="col-lg-3 col-xxl-2 col-sm-12 logo">
                <img src="/images/logo3.png" height="150" alt="">
            </div>
            <div class="col-lg-9 col-xxl-10 col-sm-12">
                <h2 class="fs-1 fw-bold text-success">Wastebuy Delivery  Co., Ltd.</h2>
            <div class="mt-2 lead">
                <p class="fs-4">Report 50 Destricts</p>
                <p class="fs-5 "> ตั้งแต่วันที่  <%= startDate  %> ถึงวันที่ <%= endDate %></p>
                <form id="searchForm" action="/report-50-Districts" method="get">
                    <div class="d-flex align-items-center no-print">
                        <div class="mx-2 d-flex flex-column">
                            <label for="startDate">Start date</label>
                            <input class="form-control" type="date" id="startDate" name="startDate" value="<%= isoValue(startDate) %>" required>
                        </div>
                        <div class="mx-2 d-flex flex-column">
                            <label for="endDate">End date</label>
                            <input class="form-control" type="date" id="endDate" name="endDate" value="<%= isoValue(endDate) %>" required>
                        </div>
                        <div class="d-flex p-2 mx-3 mt-2 justify-content-between" style="position: relative; top: 10px;">
                                <button type="button" class="btn btn-warning mx-1 px-4 my-4 text-white shadow-sm rounded-5" style="height: 30px; font-size: 12px;" id="export-excel">Excel</button>
                                <button type="button" class="btn btn-primary mx-1 px-4 my-4 rounded-5 shadow-sm" id="generate-pdf-btn"  style="height: 30px; font-size: 12px;" onclick="window.print()">Print</button>
                        </div>
                        <div class="d-flex">
                            <button class="btn btn-success px-4 text-white shadow-sm rounded-5" type="submit" style="height: 40px; margin-top: 25px;">Search</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        <div class="border-2 border-top mt-4">
            <div class="py-2">
                <div class="rounded-2 d-flex flex-column align-items-center">
<div class="table-responsive" style="width: 90%;">
                    <table class="table table-sm align-middle mb-0" style="font-size: 10px;">
                        <caption class="visually-hidden">น้ำหนักและก๊าซเรือนกระจก แยกรายเขต</caption>
                        <thead class="bg-success text-white">
                            <tr>
                                <th scope="col" style="width: 5%;">No.</th>
                                <th scope="col">Districts</th>
                                <th scope="col">District Groups</th>
                                <th scope="col" class="text-end">Weight</th>
                                <th scope="col" class="text-end">Price</th>
                                <th scope="col" class="text-end">GHG</th>
                                <th scope="col" class="text-end">Tree</th>
                            </tr>
                        </thead>
                        <tbody>
                            <%
                            // app.js ส่งรายชื่อเขตแต่ละกลุ่มมาให้แล้ว ไม่ต้องประกาศซ้ำในนี้
                            const zoneOf = (amphure) =>
                                  easternDis.includes(amphure) ? 'กรุงเทพตะวันออก'
                                : northDis.includes(amphure)   ? 'กรุงเทพเหนือ'
                                : centralDis.includes(amphure) ? 'กรุงเทพกลาง'
                                : southDis.includes(amphure)   ? 'กรุงเทพใต้'
                                : northTon.includes(amphure)   ? 'กรุงธนเหนือ'
                                : southTon.includes(amphure)   ? 'กรุงธนใต้'
                                : 'นอกเขตพื้นที่กรุงเทพ';
                            const money = (n) => (n).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                            %>
                            <% total.forEach(total => { %>
                                <% if (total.amphures !== null) { %>
                                <tr class="body-content">
                                    <td><%= count++ %></td>
                                    <td><%= total.amphures %></td>
                                    <td><%= zoneOf(total.amphures) %></td>
                                    <td class="kg text-end"><%= (total.kg_delivery).toLocaleString() %></td>
                                    <td class="price text-end"><%= money(total.total_delivery) %></td>
                                    <td class="ghg text-end"><%= money(total.ghg) %></td>
                                    <td class="tree text-end"><%= (parseInt(total.ghg / 9.4999)).toLocaleString() %></td>
                                </tr>
                                <% } %>
                            <% }); %>
                            <tr class="body-content">
                                <td>99</td>
                                <td>ลูกค้าทั่วไป</td>
                                <td>ไม่ระบุเขตพื้นที่</td>
                                <td class="kg text-end"><%= money(PublicSum.kg_delivery) %></td>
                                <td class="price text-end"><%= money(PublicSum.total_delivery) %></td>
                                <td class="ghg text-end"><%= money(PublicSum.ghg) %></td>
                                <td class="tree text-end"><%= (parseInt(PublicSum.ghg / 9.4999)).toLocaleString() %></td>
                            </tr>
                            <tr class="body-content">
                                <td>100</td>
                                <td>ลูกค้า Line</td>
                                <td>ไม่ระบุเขตพื้นที่</td>
                                <td class="kg text-end"><%= money(Linesum.kg_delivery) %></td>
                                <td class="price text-end"><%= money(Linesum.total_delivery) %></td>
                                <td class="ghg text-end"><%= money(Linesum.ghg) %></td>
                                <td class="tree text-end"><%= (parseInt(Linesum.ghg / 9.4999)).toLocaleString() %></td>
                            </tr>
                        </tbody>
                        <tfoot class="fw-bold border-top border-2" style="font-size: 12px;">
                            <tr>
                                <td colspan="3">รวม</td>
                                <td class="totalKg text-end"></td>
                                <td class="totalPrice text-end"></td>
                                <td class="totalGhg text-end"></td>
                                <td class="totalTree text-end"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>


<script>
    $(document).ready(function() {

        function processCalc(part, totalPart) {
            var total = 0;
            $(part).each(function() {
                // ต้องใช้ /,/g — replace(',','') ตัดลูกน้ำแค่ตัวแรก ทำให้ parseFloat
                // อ่าน "2,182,454.75" เหลือ 2182 ยอดรวมจึงขาดไปเงียบ ๆ เมื่อค่าเกินหลักล้าน
                let weightText = $(this).text().trim().replace(/,/g,'')
                let replaceText = weightText.replace(/.*\((.*?)\).*/, '$1');
                let weight = parseFloat(replaceText) || 0 ;

                total += weight;

            })
            $(totalPart).html(total.toLocaleString());

        }

        let kg = '.kg';
        let price = '.price';
        let ghg = '.ghg';
        let tree = '.tree';

        let totalKg = '.totalKg';
        let totalGhg = '.totalGhg';
        let totalPrice = '.totalPrice';
        let totalTree = '.totalTree';

        setTimeout(function() {
            processCalc(kg, totalKg);
            processCalc(ghg, totalGhg);
            processCalc(price, totalPrice);
            processCalc(tree, totalTree);
        },500)

    });
    document.getElementById('export-excel').addEventListener('click', function() {
    // เลือก container ที่เก็บข้อมูล
    const table = document.querySelector('.scroll-content');

    // เลือกแถวของตาราง
    const rows = table.querySelectorAll('.body-content');

    // สร้าง array สำหรับเก็บข้อมูล
    const data = [['No.', 'Districts', 'District Groups', 'Weight', 'Price', 'GHG', 'Tree']];

    // ดึงข้อมูลจากแต่ละแถว
    rows.forEach(row => {
        const cells = row.querySelectorAll('td');
        const rowData = Array.from(cells).map(cell => cell.textContent.trim());
        data.push(rowData);
    });

    // สร้าง workbook และ worksheet
    const wb = XLSX.utils.book_new();
    const ws = XLSX.utils.aoa_to_sheet(data);

    XLSX.utils.book_append_sheet(wb, ws, 'Sheet1');

    // สร้าง blob ของ Excel
    const wbout = XLSX.write(wb, { bookType: 'xlsx', type: 'binary' });

    // ฟังก์ชันสำหรับแปลง binary เป็น array buffer
    function s2ab(s) {
        const buf = new ArrayBuffer(s.length);
        const view = new Uint8Array(buf);
        for (let i = 0; i < s.length; i++) view[i] = s.charCodeAt(i) & 0xFF;
        return buf;
    }

    // ดาวน์โหลดไฟล์
    const filename = 'รายงานน้ำหนักและก๊าซเรือนกระจกแบ่งรายเขต.xlsx';
    const link = document.createElement('a');
    link.href = URL.createObjectURL(new Blob([s2ab(wbout)], { type: 'application/octet-stream' }));
    link.download = filename;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
});
</script>

<%- include('partials/footer') %>
