<%- include('index') %>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- Bootstrap JS (necessary for dropdowns) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.0/xlsx.full.min.js"></script>
<body>
    <div class="container scroll-content ">
        <div class="centent row py-5 px-4 ">
            <div class="col-lg-3 col-xxl-2 col-sm-12 logo">
                <img src="/images/logo3.png" height="150" alt="">
            </div>
            <div class="col-lg-9 col-xxl-10 col-sm-12">
                <h2 class="fs-1 fw-bold">Wastebuy Delivery Ltd,. Co.</h2>
            <div class="mt-2 lead">
                <p class="fs-4">Report 50 Destricts</p>
                <p class="fs-5 "> ตั้งแต่วันที่  <%= startDate  %> ถึงวันที่ <%= endDate %></p>
                <form id="searchForm" action="/report-50-Districts" method="get">
                    <div class="d-flex align-items-center no-print">
                        <div class="mx-2 d-flex flex-column">
                            <label for="startDate">Start date</label>
                            <input class="form-control" type="date" id="startDate" name="startDate" required>
                        </div>
                        <div class="mx-2 d-flex flex-column">
                            <label for="endDate">End date</label>
                            <input class="form-control" type="date" id="endDate" name="endDate" required>
                        </div>
                        <div class="d-flex p-2 mx-3 mt-2 justify-content-space-between" style="position: relative; top: 10px;">
                            <form action="">
                                <div class="btn btn-warning mx-1 px-4 my-4 text-white shadow-sm rounded-5" style="height: 30px; font-size: 12px;" id="export-excel">Excel</div>
                                <div class="btn btn-primary mx-1 px-4 my-4 rounded-5 shadow-sm" id="generate-pdf-btn"  style="height: 30px; font-size: 12px;" onclick="window.print()">Print</div>
                            </form>
                        </div>
                        <div class="d-flex">
                            <button class="btn btn-success px-4 text-white shadow-sm rounded-5" type="submit" style="height: 40px; margin-top: 25px;">Search</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        <div class="mx-4 border-2 border-top mt-4">
            <div class="px-1 py-2">
                <div class="rounded-2 d-flex flex-column align-items-center">
                    <div class="header-content row bg-success rounded-top fw-bold  text-white py-2" style="width: 90%; font-size: 10px;">
                        <div class="col">No.</div>
                        <div class="col">Districts</div>
                        <div class="col">District Groups</div>
                        <div class="col">Weight</div>
                        <div class="col">Price</div>
                        <div class="col">GHG</div>
                        <div class="col">Tree</div>
                    </div>
                    <% total.forEach(total => {%>
                       <% if (total.amphures !== null) {%>
                    <div class="row py-2 border-top body-content border-start border-end " style="width: 90%; font-size: 10px;">
                        <div class="col"><%= count++ %></div>
                        <div class="col"><%= total.amphures %></div>
                        <% 
                        const easternDis = [
                            "เขตลาดกระบัง",
                            "เขตหนองจอก",
                            "เขตบางกะปิ",
                            "เขตประเวศ",
                            "เขตบึงกุ่ม",
                            "เขตคันนายาว",
                            "เขตมีนบุรี",
                            "เขตคลองสามวา"
                        ]
                        const northDis = [
                            "เขตสายไหม",
	                        "เขตจตุจักร",
	                        "เขตหลักสี่",
	                        "เขตดอนเมือง",
	                        "เขตบางซื่อ",
	                        "เขตลาดพร้าว",
	                        "เขตบางเขน"
                        ]

                        const centralDis = [
                            "เขตป้อมปราบศัตรูพ่าย",
	                        "เขตวังทองหลาง",
	                        "เขตสัมพันธวงศ์",
	                        "เขตพญาไท",
	                        "เขตดินแดง", 
	                        "เขตดุสิต",
	                        "เขตพระนคร",
	                        "เขตห้วยขวาง",
	                        "เขตราชเทวี"
                        ]

                        const southDis = [
                            "เขตวัฒนา",
	                        "เขตสวนหลวง",
	                        "เขตพระโขนง",
	                        "เขตสาทร",
	                        "เขตคลองเตย",
	                        "เขตบางคอแหลม",
	                        "เขตปทุมวัน",
	                        "เขตบางรัก",
	                        "เขตยานนาวา",
	                        "เขตบางนา" 
                        ]
                        const northTon = [
                            "เขตบางพลัด",
	                        "เขตบางกอกน้อย",
	                        "เขตบางกอกใหญ่",
	                        "เขตตลิ่งชัน",
	                        "เขตทวีวัฒนา",
	                        "เขตจอมทอง",
	                        "เขตธนบุรี",
	                        "เขตคลองสาน"
                        ]

                        const southTon = [
                            "เขตบางขุนเทียน",
	                        "เขตบางแค",
	                        "เขตหนองแขม",
	                        "เขตภาษีเจริญ",
	                        "เขตบางบอน",
	                        "เขตทุ่งครุ",
	                        "เขตราษฎร์บูรณะ"
                        ]
                            if (easternDis.includes(total.amphures)) {
                        %>
                                <div class="col">กรุงเทพตะวันออก</div>
                        <%} else if (northDis.includes(total.amphures)) {%>
                                <div class="col">กรุงเทพเหนือ</div>
                        <%} else if (centralDis.includes(total.amphures)) {%>
                                <div class="col">กรุงเทพกลาง</div>
                        <%} else if (southDis.includes(total.amphures)) {%>
                                <div class="col">กรุงเทพใต้</div>
                        <%} else if (northTon.includes(total.amphures)) {%>
                                <div class="col">กรุงธนเหนือ</div>
                        <%} else if (southTon.includes(total.amphures)) {%>
                                <div class="col">กรุงธนเหนือ</div>
                        <% } else  {%>
                                <div class="col">นอกเขตพื้นที่กรุงเทพ</div>
                        <% } %>
                        <div class="col kg"><%= (total.kg_delivery).toLocaleString() %></div>
                        <div class="col price"><%= (total.total_delivery).toLocaleString() %></div>
                        <div class="col ghg"><%= (total.ghg).toLocaleString() %></div>
                        <div class="col tree"><%= parseInt(total.kg_delivery / 9.5) %></div>
                    </div>
                    <% } %>
                   <% }); %>
                   <div class="row py-3 fw-bold border rounded-bottom border-top border-2 body-content" style="width: 90%; font-size: 12px;">
                    <div class="col"></div>
                    <div class="col"></div>
                    <div class="col">รวม</div>
                    <div class="col totalKg"></div>
                    <div class="col totalPrice"></div>
                    <div class="col totalGhg"></div>
                    <div class="col totalTree"></div>
                </div>


<script>
    $(document).ready(function() {
        
        function processCalc(part, totalPart) {
            var total = 0;
            $(part).each(function() {
                let weightText = $(this).text().trim().replace(',','')
                let replaceText = weightText.replace(/.*\((.*?)\).*/, '$1');
                let weight = parseFloat(replaceText) || 0 ;

                total += weight;
                
            })
            $(totalPart).html(total.toLocaleString());
            
        }
        
        let kg = '.kg';
        let price = '.price';
        let ghg = '.ghg';
        let tree = '.tree';

        let totalKg = '.totalKg';
        let totalGhg = '.totalGhg';
        let totalPrice = '.totalPrice';
        let totalTree = '.totalTree';

        setTimeout(function() {
            processCalc(kg, totalKg);
            processCalc(ghg, totalGhg);
            processCalc(price, totalPrice);
            processCalc(tree, totalTree);
        },500)

    });
    document.getElementById('export-excel').addEventListener('click', function() {
    // เลือก container ที่เก็บข้อมูล
    const table = document.querySelector('.scroll-content');
    
    // เลือกแถวของตาราง
    const rows = table.querySelectorAll('.body-content');
    
    // สร้าง array สำหรับเก็บข้อมูล
    const data = [['No.', 'Districts', 'District Groups', 'Weight', 'GHG', 'Tree']];

    // ดึงข้อมูลจากแต่ละแถว
    rows.forEach(row => {
        const cells = row.querySelectorAll('div');
        const rowData = Array.from(cells).map(cell => cell.textContent.trim());
        data.push(rowData);
    });

    // สร้าง workbook และ worksheet
    const wb = XLSX.utils.book_new();
    const ws = XLSX.utils.aoa_to_sheet(data);

    XLSX.utils.book_append_sheet(wb, ws, 'Sheet1');

    // สร้าง blob ของ Excel
    const wbout = XLSX.write(wb, { bookType: 'xlsx', type: 'binary' });

    // ฟังก์ชันสำหรับแปลง binary เป็น array buffer
    function s2ab(s) {
        const buf = new ArrayBuffer(s.length);
        const view = new Uint8Array(buf);
        for (let i = 0; i < s.length; i++) view[i] = s.charCodeAt(i) & 0xFF;
        return buf;
    }

    // ดาวน์โหลดไฟล์
    const filename = '50_districts.xlsx';
    const link = document.createElement('a');
    link.href = URL.createObjectURL(new Blob([s2ab(wbout)], { type: 'application/octet-stream' }));
    link.download = filename;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
});
</script>