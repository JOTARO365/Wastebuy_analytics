<%- include('partials/header') %>


<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />


<!-- XLSX -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.0/xlsx.full.min.js"></script>

<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<style>
  #map { height: 640px; }
  .font-size { font-size: 13px; }
  .grid_customer { grid-template-columns: 30px 2fr 1fr 1fr; }
  .grid_employees { grid-template-columns: 30px 1fr; }

  .scroll-10 { max-height: 420px; overflow: auto; }

  .driver-item { cursor: pointer; }
  .driver-panel { display: none; }
  .driver-item.active + .driver-panel { display: block; }

  .customer-item { display: flex; justify-content: space-between; align-items: center; }
  .tag { font-size: 0.85rem; }

  .section-title { display:flex; align-items:center; gap:.5rem; }
  .section-title .badge { font-weight: 500; }
</style>
  <div class="container">
    <div class="content row px-4">
      <div class="col-lg-3 col-xxl-2 col-sm-12 logo">
        <img src="/images/logo3.png" height="150" alt="">
      </div>
      <div class="col-lg-9 col-xxl-10 col-sm-12">
        <h2 class="fs-1 fw-bold text-success">Wastebuy Delivery Co., Ltd.</h2>
        <div class="mt-2 lead">
          <p class="fs-4">Scheduling System</p>
          <p class="fs-5">ตั้งแต่วันที่ <%= startDate %> ถึงวันที่ <%= endDate %></p>

          <form id="searchForm" action="/Scheduling-system" method="get">
            <div class="d-flex align-items-center no-print">
              <div class="mx-2 d-flex flex-column">
                <label for="startDate">Start date</label>
                <input class="form-control" type="date" id="startDate" name="startDate" required>
              </div>
              <div class="mx-2 d-flex flex-column">
                <label for="endDate">End date</label>
                <input class="form-control" type="date" id="endDate" name="endDate" required>
              </div>

              <div class="d-flex">
                <button class="btn btn-success px-4 text-white shadow-sm rounded-5" type="submit" style="height: 40px; margin-top: 25px;">Search</button>
              </div>

              <div class="d-flex p-2">
                <button class="btn btn-primary px-4 text-white shadow-sm rounded-5" id="btn-open-queue" type="button" style="height: 40px; margin-top: 25px;" data-bs-toggle="modal" data-bs-target="#queueModal">
                  จัดคิวงาน
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- แผนที่ -->
  <div class="mt-2" id="map"></div>

  <!-- ===== Modal: จัดคิว ===== -->
  <div class="modal fade" id="queueModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">จัดคิวงาน</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="ปิด"></button>
        </div>
        <div class="modal-body">
          <div class="row g-4">

            <!-- ซ้าย: คนขับ -->
            <div class="col-12 col-lg-6">
              <!-- ลิสต์คนขับปฏิบัติงาน -->
              <div class="section-title mb-2">
                <h6 class="mb-0">คนขับ (ปฏิบัติงาน)</h6>
                <span class="badge text-bg-light"><span id="driverActiveCount">0</span> รายชื่อ</span>
              </div>
              <ul id="driverListActive" class="list-group scroll-10 mb-3"></ul>

              <!-- ลิสต์วันหยุด -->
              <div class="section-title mb-2 mt-3">
                <h6 class="mb-0">วันหยุด</h6>
                <span class="badge text-bg-light"><span id="driverOffCount">0</span> รายชื่อ</span>
              </div>
              <ul id="driverListOff" class="list-group scroll-10"></ul>
            </div>

            <!-- ขวา: ลูกค้า -->
            <div class="col-12 col-lg-6">
              <div class="d-flex align-items-center mb-2 gap-2">
                <h6 class="mb-0">ลูกค้า</h6>
                <span class="badge text-bg-light"><span id="customerCount"><%= mapData.length %></span> รายชื่อ</span>
              </div>
              <div class="input-group mb-2">
                <span class="input-group-text">ค้นหา</span>
                <input id="customerSearch" type="text" class="form-control" placeholder="พิมพ์ชื่อ/เขต/เบอร์/ที่อยู่">
              </div>
              <ul id="customerList" class="list-group scroll-10"></ul>
            </div>

          </div>
        </div>
        <div class="modal-footer">
          <button class="btn btn-outline-secondary" data-bs-dismiss="modal">ปิด</button>
          <button id="savePlanBtn" class="btn btn-success">บันทึกแผน</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    // ====== Leaflet Map ======
    const map = L.map('map').setView([13.75, 100.51], 11);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(map);

    const data = <%- JSON.stringify(mapData) %>;
    const markerLayer = L.layerGroup().addTo(map);

	const stationIcon	= L.icon({
		iconUrl: '/images/station.png',
		iconSize: [32, 32],
		iconAnchor: [16, 32],
		popupAnchor: [0, -28]
	});

    data.forEach(loc => {
      if (typeof loc.lat === 'number' && typeof loc.lng === 'number') {
        L.circleMarker([loc.lat, loc.lng], {
          radius: 8, color: 'green', fillColor: '#16a34a', fillOpacity: 0.85, weight: 1
        })
        .addTo(markerLayer)
        .bindPopup(`<b>ชื่อลูกค้า: ${loc.label}</b>
                    <br>วันที่จอง: ${loc.booking_date || '-'}
                    <br>เขต: ${loc.district || '-'}
                    <br>เบอร์โทร: ${loc.phonenumber || '-'}`);
      } else {
        console.warn('location Not Found:', loc.label);
      }
    });

const stations = [
  { lat: 13.751053, lng: 100.7188289, name: "STATION ลาดกระบัง" },
  { lat: 13.6357915, lng: 100.3770416, name: "STATION บางบอน" }
];
stations.forEach(st => {
	L.marker([st.lat, st.lng], {icon: stationIcon}).addTo(markerLayer).bindPopup(`<b>${st.name}</b>`);
});
  </script>

  <script>
    // ====== Modal Queue Logic ======
    const EMPLOYEES = <%- JSON.stringify(employees.map((e, i) => ({
      id: i + 1,
      name: e.full_name
    }))) %>;

    const CUSTOMERS = <%- JSON.stringify(mapData.map((c, i) => ({
      id: i + 1,
      name: c.label,
      phone: c.phonenumber || '-',
      district: c.district || '-',
      address: c.address || '-',           // ใช้ใน UI และ Excel
	  bookingDate: c.booking_date || '-'
    }))) %>;

    const state = {
      drivers: EMPLOYEES,               // [{id, name}]
      customers: CUSTOMERS,             // [{id, name, phone, district, address}]
      availableCustomerIds: new Set(),  // ลูกค้าที่ "ยังไม่ถูก assign"
      assignments: {},                  // driverId -> [{...customer}]
      ui: {
        openDriverIds: new Set(),       // เปิดหลาย panel ได้
        lastActiveDriverId: null,       // ใช้เป็นเป้าหมายเวลากด "เลือก"
        offDriverIds: new Set()         // คนขับที่อยู่ในลิสต์ "วันหยุด"
      }
    };

    // init
    state.customers.forEach(c => state.availableCustomerIds.add(c.id));
    state.drivers.forEach(d => state.assignments[d.id] = []);

    const driverListActiveEl = document.getElementById('driverListActive');
    const driverListOffEl = document.getElementById('driverListOff');
    const customerListEl = document.getElementById('customerList');
    const customerSearchEl = document.getElementById('customerSearch');
    const customerCountEl = document.getElementById('customerCount');
    const driverActiveCountEl = document.getElementById('driverActiveCount');
    const driverOffCountEl = document.getElementById('driverOffCount');

    function moveDriverOff(driverId) {
      state.ui.openDriverIds.delete(driverId);
      state.ui.offDriverIds.add(driverId);
      renderDrivers();
    }

    function restoreDriver(driverId) {
      state.ui.offDriverIds.delete(driverId);
      renderDrivers();
    }

    function renderDrivers() {
      driverListActiveEl.innerHTML = '';
      driverListOffEl.innerHTML = '';

      const activeDrivers = state.drivers.filter(d => !state.ui.offDriverIds.has(d.id));
      const offDrivers = state.drivers.filter(d => state.ui.offDriverIds.has(d.id));

      driverActiveCountEl.textContent = String(activeDrivers.length);
      driverOffCountEl.textContent = String(offDrivers.length);

      // === Active Drivers ===
      activeDrivers.forEach(d => {
        const item = document.createElement('li');
        item.className = 'list-group-item driver-item d-flex justify-content-between align-items-center';
        item.dataset.id = d.id;
        item.innerHTML = `
          <div class="fw-medium">${d.name}</div>
          <div class="d-flex align-items-center gap-2">
            <span class="badge rounded-pill text-bg-light">${state.assignments[d.id].length}</span>
            <button class="btn btn-sm btn-outline-danger btn-off">หยุดปฏิบัติงาน</button>
          </div>
        `;
        item.addEventListener('click', (ev) => {
          if (ev.target && ev.target.closest('.btn-off')) return;
          toggleDriverPanel(d.id, item);
        });

        const panel = document.createElement('div');
        panel.className = 'driver-panel p-2 border-bottom';
        panel.innerHTML = `
          <div class="input-group mb-2">
            <span class="input-group-text">ค้นหาลูกค้า</span>
            <input type="text" class="form-control driver-search" placeholder="พิมพ์ชื่อที่มีอยู่" />
            <button class="btn btn-outline-success btn-move">โยกงาน</button>
          </div>
          <div class="small text-secondary mb-2">ลูกค้าที่ถูกมอบหมาย:</div>
          <div class="d-flex flex-wrap gap-2 assigned-tags"></div>
        `;

        // ปุ่มหยุด
        item.querySelector('.btn-off').addEventListener('click', () => {
          moveDriverOff(d.id);
        });

        // ปุ่มโยกงานจาก search
        panel.querySelector('.btn-move').addEventListener('click', () => {
          const q = panel.querySelector('.driver-search').value.trim();
          if (!q) return;
          const found = findAvailableCustomerByName(q);
          if (!found) { notify('ไม่พบลูกค้าที่ว่างชื่อตรงกับที่ค้นหา'); return; }
          assignToDriver(d.id, found.id);
          panel.querySelector('.driver-search').value = '';
          renderCustomers();
          renderDrivers();
        });

        driverListActiveEl.appendChild(item);
        driverListActiveEl.appendChild(panel);
        refreshAssignedTags(panel.querySelector('.assigned-tags'), d.id);

        if (state.ui.openDriverIds.has(d.id)) {
          item.classList.add('active');
          panel.style.display = 'block';
        }
      });

      // === Off Drivers ===
      offDrivers.forEach(d => {
        const item = document.createElement('li');
        item.className = 'list-group-item d-flex justify-content-between align-items-center';
        item.dataset.id = d.id;
        item.innerHTML = `
          <div class="fw-medium text-secondary">${d.name}</div>
          <div class="d-flex align-items-center gap-2">
            <span class="badge rounded-pill text-bg-light">${state.assignments[d.id].length}</span>
            <button class="btn btn-sm btn-outline-success btn-restore">ย้ายกลับ</button>
          </div>
        `;
        item.querySelector('.btn-restore').addEventListener('click', () => {
          restoreDriver(d.id);
        });
        driverListOffEl.appendChild(item);
      });
    }

    function refreshAssignedTags(container, driverId) {
      container.innerHTML = '';
      state.assignments[driverId].forEach(c => {
        const tag = document.createElement('span');
        tag.className = 'badge rounded-pill text-bg-success tag d-flex align-items-center gap-2';
        tag.innerHTML = `
          <span>
            <div><strong>${c.name}</strong></div>
            <div class="small">เขต: ${c.district} | โทร: ${c.phone}</div>
          </span>
          <button class="btn-close btn-close-white btn-sm" aria-label="ลบ"></button>
        `;
        tag.querySelector('button').addEventListener('click', () => {
          unassignFromDriver(driverId, c.id);
          renderCustomers();
          renderDrivers();
        });
        container.appendChild(tag);
      });
    }

    function toggleDriverPanel(driverId, itemEl) {
      const panel = itemEl.nextElementSibling;
      const isOpen = state.ui.openDriverIds.has(driverId);
      if (isOpen) {
        state.ui.openDriverIds.delete(driverId);
        itemEl.classList.remove('active');
        panel.style.display = 'none';
      } else {
        state.ui.openDriverIds.add(driverId);
        state.ui.lastActiveDriverId = driverId;
        itemEl.classList.add('active');
        panel.style.display = 'block';
      }
    }

 function renderCustomers() {
  const q = customerSearchEl.value.trim().toLowerCase();
  const tokens = q.split(/\s+/).filter(Boolean); // แยกหลายคำค้นด้วยช่องว่าง

  const available = [...state.availableCustomerIds]
    .map(id => state.customers.find(c => c.id === id));

  const filtered = tokens.length
    ? available.filter(c => {
        // รวมฟิลด์ที่ใช้ค้นหา
        const hay = [
          c.name || '',
          c.district || '',
          c.phone || '',
          c.address || ''
        ].join(' ').toLowerCase();

        // ทุกคำต้องพบในสตริงรวม
        return tokens.every(t => hay.includes(t));
      })
    : available;

  customerListEl.innerHTML = '';
  filtered.forEach(c => {
    const li = document.createElement('li');
    li.className = 'list-group-item customer-item';
    li.innerHTML = `
      <div>
        <div><strong>${c.name}</strong></div>
        <div class="small text-secondary">
          เขต: ${c.district} | โทร: ${c.phone}
          ${c.bookingDate && c.bookingDate !== '-' ? `<br>วันที่จอง: ${c.bookingDate}` : ''}
          ${c.address && c.address !== '-' ? `<br>ที่อยู่: ${c.address}` : ''}
        </div>
      </div>
      <button class="btn btn-sm btn-outline-primary btn-pick">เลือก</button>
    `;

    // ปุ่ม "เลือก"
    li.querySelector('.btn-pick').addEventListener('click', () => {
      const fallback = state.drivers.find(d => !state.ui.offDriverIds.has(d.id))?.id;
      const last = state.ui.lastActiveDriverId;
      const targetId = (last && !state.ui.offDriverIds.has(last)) ? last : fallback;

      if (!targetId) { notify('ไม่พบคนขับที่พร้อมรับงาน'); return; }
      assignToDriver(targetId, c.id);
      renderCustomers();
      renderDrivers();
    });

    customerListEl.appendChild(li);
  });

  customerCountEl.textContent = state.availableCustomerIds.size;
}


    function findAvailableCustomerByName(q) {
      const pool = [...state.availableCustomerIds].map(id => state.customers.find(c => c.id === id));
      return pool.find(c => c.name.toLowerCase().includes(q.toLowerCase()));
    }

    function assignToDriver(driverId, customerId) {
      if (!state.availableCustomerIds.has(customerId)) return;
      const c = state.customers.find(x => x.id === customerId);
      state.assignments[driverId].push(c);
      state.availableCustomerIds.delete(customerId);
    }

    function unassignFromDriver(driverId, customerId) {
      const arr = state.assignments[driverId];
      const idx = arr.findIndex(x => x.id === customerId);
      if (idx >= 0) arr.splice(idx, 1);
      state.availableCustomerIds.add(customerId);
    }

    customerSearchEl.addEventListener('input', renderCustomers);

    // เปิด Modal ครั้งแรกแล้วค่อย render lists
    const modalEl = document.getElementById('queueModal');
    modalEl.addEventListener('shown.bs.modal', () => {
      renderDrivers();
      renderCustomers();
    });

    // ===== Export Excel (Address included, Range removed) =====
    function toAssignmentRows() {
      const rows = [];
      state.drivers.forEach(d => {
        const jobs = state.assignments[d.id] || [];
        jobs.forEach(c => {
          rows.push({
            Driver: d.name + (state.ui.offDriverIds.has(d.id) ? ' (หยุด)' : ''),
			driver_number: '-',
			No: '-',
            Customer: c.name,
			range: '-',
			Address: c.address || '-',
            Phone: c.phone || '-',
			note: '-'
          });
        });
      });
      return rows;
    }

    function toUnassignedRows() {
      const rows = [];
      [...state.availableCustomerIds].forEach(id => {
        const c = state.customers.find(x => x.id === id);
        if (!c) return;
        rows.push({
          Customer: c.name,
          District: c.district || '-',
          Phone: c.phone || '-',
          Address: c.address || '-'
        });
      });
      return rows;
    }

    function exportAssignmentsToExcel() {
      const assigned = toAssignmentRows();
      const unassigned = toUnassignedRows();

      if (assigned.length === 0 && unassigned.length === 0) {
        console.log('ยังไม่มีข้อมูลคิวงานให้ส่งออก');
        return;
      }

      const wb = XLSX.utils.book_new();

      const ws1 = XLSX.utils.json_to_sheet(
        assigned.length ? assigned : [{ Driver: '-', Driver_number: '-', No: '-', Customer: '-', range: '-', Address: '-', Phone: '-', note: '-' }]
      );
      ws1['!cols'] = [{wch:16},{wch:16},{wch:10},{wch:16},{wch:16},{wch:40},{wch:26},{wch:26}];
      XLSX.utils.book_append_sheet(wb, ws1, 'Assignments');

      const ws2 = XLSX.utils.json_to_sheet(
        unassigned.length ? unassigned : [{ Customer: '-', District: '-', Phone: '-', Address: '-' }]
      );
      ws2['!cols'] = [{wch:28},{wch:16},{wch:16},{wch:40}];
      XLSX.utils.book_append_sheet(wb, ws2, 'Unassigned');

      const s = `<%= startDate %>`.replaceAll('/','-');
      const e = `<%= endDate %>`.replaceAll('/','-');
      const ts = new Date().toISOString().replace(/[:T]/g,'-').slice(0,19);
      const filename = `Scheduling_${s}_to_${e}_${ts}.xlsx`;

      XLSX.writeFile(wb, filename);
    }

    document.getElementById('savePlanBtn').addEventListener('click', () => {
      try {
        exportAssignmentsToExcel();
        console.log('SAVE payload:', { assignments: state.assignments, offDriverIds: [...state.ui.offDriverIds] });
      } catch (err) {
        console.error('Export Excel error:', err);
        console.log('เกิดข้อผิดพลาดระหว่างส่งออก Excel');
      }
    });
  </script>

<%- include('partials/footer') %>
